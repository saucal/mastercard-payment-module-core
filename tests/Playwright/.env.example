# Copy to .env (gitignored) and fill in. See README.md for the full table.

# --- Installs -----------------------------------------------------------
# One per parallel worker. workers is derived from how many are configured and
# never exceeds it: two workers on one site fight over configureGateway(),
# which rewrites site-global settings.
#
# Either set WP_BASE_URLS (comma-separated, takes precedence)...
# WP_BASE_URLS=https://site-one.example,https://site-two.example,https://site-three.example
#
# ...or the individual vars. A single URL is fine — that just means one worker.
WP_BASE_URL=
WP_BASE_STG_URL=
WP_BASE_DEV_URL=

# --- Credentials --------------------------------------------------------
WP_USERNAME=admin
WP_PASSWORD=
WP_ADMIN_PASS=

# Admin application password per install, in the same order as the URLs above.
# Generate with: node scripts/mint-app-passwords.mjs
WP_API_PASS=
WP_API_PASS_2=
WP_API_PASS_3=

# WooCommerce REST consumer key / secret.
WOO_USER=
WOO_PASS=

# --- Gateway identity ---------------------------------------------------
# GATEWAY_SLUG is the gateway id, e.g. mastercard_merchant_cloud.
# META_PREFIX is the order-meta prefix — the built hook prefix, normally the
# same value. GATEWAY_DISPLAY_NAME must match the gateway's `title` setting
# exactly, or the payment method will not be found at checkout.
GATEWAY_SLUG=
META_PREFIX=
GATEWAY_DISPLAY_NAME=

# --- Fixtures -----------------------------------------------------------
# Product IDs. Defaults are 61 / 316 / 66 if unset.
#
# The digital product MUST be virtual AND downloadable: WooCommerce only
# auto-completes an order when every item is both, and the digital-product
# tests assert Completed. Virtual-only stops at Processing and fails
# deterministically.
PRODUCT_PHYSICAL=
PRODUCT_DIGITAL=
PRODUCT_SUBSCRIPTION=
